<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top App Header / Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/bg_secondary"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="VOLSTEP TERMINAL"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_app_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_app_logo"
                android:backgroundTint="@color/accent_cyan"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="PRO v2"
                android:textColor="@color/bg_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Server IP Config Button -->
            <ImageButton
                android:id="@+id/btn_server_config"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_server"
                app:tint="@color/accent_cyan"
                android:contentDescription="Set Server IP" />

            <!-- Connection Status Dot -->
            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_toStartOf="@id/btn_server_config"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="@color/warn_yellow" />

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Swipe Refresh Layout containing WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Offline / Connection Error Overlay (Shown if host is unreachable) -->
    <LinearLayout
        android:id="@+id/layout_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:background="@color/bg_primary"
        app:layout_constraintTop_toBottomOf="@id/top_toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_server"
            app:tint="@color/bad_red"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tidak Dapat Terhubung ke Server Bot"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tv_current_target_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target: http://192.168.1.xxx:5050"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pastikan server bot Rust sudah berjalan di PC / VPS Anda dan HP terhubung di jaringan WiFi yang sama."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_retry_conn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Coba Hubungkan Ulang"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/bg_primary" />

        <Button
            android:id="@+id/btn_change_ip_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ubah Alamat IP Server"
            android:textColor="@color/accent_cyan"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_secondary"
        app:itemIconTint="@color/nav_active"
        app:itemTextColor="@color/nav_active"
        app:itemRippleColor="@color/accent_cyan"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
