<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_settings_title"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_dialog_desc"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@color/bg_secondary"
        android:hint="@string/server_url_hint"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:padding="12dp"
        android:inputType="textUri"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tv_test_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_dialog_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_test"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/accent_cyan" />

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_muted"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_dialog_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/bg_primary"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
