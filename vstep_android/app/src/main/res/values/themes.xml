<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme: Dark Material Design -->
    <style name="Theme.VolStep.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status Bar & Navigation Bar Colors -->
        <item name="android:statusBarColor">@color/bg_secondary</item>
        <item name="android:navigationBarColor">@color/bg_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Primary Branding Colors -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Background & Surface Colors -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_main</item>
    </style>
</resources>
